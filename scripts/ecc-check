#!/usr/bin/env bash

# --- Defaults (used when the script is run without arguments) ---
HOST="172.29.2.30"
COMMUNITY="rd_ced1_ECC800"
MIB_DIR="$HOME/MIB"
GROUP="all"
TIMEOUT=3
SHOW_NUMERIC=0
USE_COLOR=1

# --- Help text ---
usage() {
  cat << HELP
Usage: $(basename "$0") [OPTIONS]

Query Huawei FusionModule800 (ECC800) sensors over SNMPv2c.
Without arguments, query all 24 sensors using the default values.

Options:
  -H <host>       ECC800 controller IP address (default: $HOST)
  -c <community>  SNMPv2c community string (default: $COMMUNITY)
  -M <dir>        Directory containing MIB files (default: $MIB_DIR)
  -g <group>      Sensor group: all | cooling | env | power | security (default: $GROUP)
  -t <seconds>    Request timeout in seconds (default: $TIMEOUT)
  -n              Also show the numeric OID (useful when working with C code)
  -C              Disable ANSI colors
  -h              Show this help message
HELP
}

# --- Parse optional arguments ---
while getopts ":H:c:M:g:t:nCh" opt; do
  case "$opt" in
    H) HOST="$OPTARG" ;;
    c) COMMUNITY="$OPTARG" ;;
    M) MIB_DIR="$OPTARG" ;;
    g) GROUP="$OPTARG" ;;
    t) TIMEOUT="$OPTARG" ;;
    n) SHOW_NUMERIC=1 ;;
    C) USE_COLOR=0 ;;
    h) usage; exit 0 ;;
    :)
      echo "Error: option -$OPTARG requires an argument." >&2
      usage >&2
      exit 1
      ;;
    \?)
      echo "Error: invalid option -$OPTARG." >&2
      usage >&2
      exit 1
      ;;
  esac
done

# --- Prerequisite checks ---
if ! command -v snmpget >/dev/null 2>&1; then
  echo "Error: 'snmpget' not found. Install the 'snmp' package." >&2
  exit 1
fi

if [[ ! -d "$MIB_DIR" ]]; then
  echo "Error: MIB directory '$MIB_DIR' does not exist." >&2
  exit 1
fi

# --- ANSI color setup ---
if [[ "$USE_COLOR" -eq 1 && -t 1 ]]; then
  C_BOLD=$'\e[1m'
  C_CYAN=$'\e[36m'
  C_GREEN=$'\e[32m'
  C_YELLOW=$'\e[33m'
  C_RED=$'\e[31m'
  C_GRAY=$'\e[37m'
  C_DIM=$'\e[90m'
  C_RESET=$'\e[0m'
else
  C_BOLD=""
  C_CYAN=""
  C_GREEN=""
  C_YELLOW=""
  C_RED=""
  C_GRAY=""
  C_DIM=""
  C_RESET=""
fi

# --- OID groups ---
OIDS_COOLING=(
  "HUAWEI-ECC-MIB::hwNetCol5000A010AverageSupplyAirTemperature.4121"
  "HUAWEI-ECC-MIB::hwNetCol5000A010AverageSupplyAirTemperature.4122"
  "HUAWEI-ECC-MIB::hwNetCol5000A010AverageReturnAirTemperature.4121"
  "HUAWEI-ECC-MIB::hwNetCol5000A010AverageReturnAirTemperature.4122"
  "HUAWEI-ECC-MIB::hwNetCol5000A010AverageColdAisleTemperature.4121"
  "HUAWEI-ECC-MIB::hwNetCol5000A010AverageColdAisleTemperature.4122"
  "HUAWEI-ECC-MIB::hwNetCol5000A010PsuInputPower.4121"
  "HUAWEI-ECC-MIB::hwNetCol5000A010PsuInputPower.4122"
  "HUAWEI-ECC-MIB::hwNetCol5000A010OnorOffStatusOfAirConditioner.4121"
  "HUAWEI-ECC-MIB::hwNetCol5000A010OnorOffStatusOfAirConditioner.4122"
)

OIDS_ENV=(
  "HUAWEI-ECC-MIB::hwTempHumTempSensor.4123"
  "HUAWEI-ECC-MIB::hwTempHumTempSensor.4124"
  "HUAWEI-ECC-MIB::hwTempHumHumSensor.4123"
  "HUAWEI-ECC-MIB::hwTempHumHumSensor.4124"
)

OIDS_POWER=(
  "HUAWEI-ECC-MIB::hwUPS2000GAOutputActivePower.4118"
  "HUAWEI-ECC-MIB::hwUPS2000GAOutputActivePower.4119"
  "HUAWEI-ECC-MIB::hwUPS2000GALoadRatio.4118"
  "HUAWEI-ECC-MIB::hwUPS2000GALoadRatio.4119"
  "HUAWEI-ECC-MIB::hwUPS2000GAPowerMode.4118"
  "HUAWEI-ECC-MIB::hwUPS2000GAPowerMode.4119"
  "HUAWEI-ECC-MIB::hwPowerModuleDcOutputPower.111"
)

OIDS_SECURITY=(
  "HUAWEI-ECC-MIB::hwECCSysAIDI1DIstatus.0"
  "HUAWEI-ECC-MIB::hwECCSysAIDI3DIstatus.0"
  "HUAWEI-ECC-MIB::hwAccessActuatorMagneticLockPortState.4110"
)

TARGET_OIDS=()
case "$GROUP" in
  all)
    TARGET_OIDS=("${OIDS_COOLING[@]}" "${OIDS_ENV[@]}" "${OIDS_POWER[@]}" "${OIDS_SECURITY[@]}")
    ;;
  cooling)
    TARGET_OIDS=("${OIDS_COOLING[@]}")
    ;;
  env)
    TARGET_OIDS=("${OIDS_ENV[@]}")
    ;;
  power)
    TARGET_OIDS=("${OIDS_POWER[@]}")
    ;;
  security)
    TARGET_OIDS=("${OIDS_SECURITY[@]}")
    ;;
  *)
    echo "Error: unknown group '$GROUP'. Use: all, cooling, env, power, security." >&2
    exit 1
    ;;
esac

# --- Query each OID and always produce readable output ---
for target in "${TARGET_OIDS[@]}"; do
  raw_out=$(snmpget -v 2c -c "$COMMUNITY" -t "$TIMEOUT" -M "$MIB_DIR" -m ALL "$HOST" "$target" 2>&1)
  rc=$?

  sym="${target%.*}"
  desc=$(snmptranslate -Td -M "$MIB_DIR" -m ALL "$sym" 2>/dev/null \
    | sed -n '/DESCRIPTION/,/::=/p' \
    | sed '$d' \
    | tr '\n' ' ' \
    | sed 's/DESCRIPTION[[:space:]]*//; s/  */ /g')

  if [[ $rc -eq 0 && "$raw_out" == *"="* ]]; then
    oid="${raw_out%%=*}"
    val="${raw_out#*=}"
    oid=$(echo "$oid" | xargs)
    val=$(echo "$val" | xargs)

    printf "${C_BOLD}NAME:${C_RESET}        ${C_CYAN}%s${C_RESET}\n" "$oid"
    if [[ "$SHOW_NUMERIC" -eq 1 ]]; then
      num_oid=$(snmptranslate -On -M "$MIB_DIR" -m ALL "$oid" 2>/dev/null)
      printf "${C_BOLD}NUMERIC OID:${C_RESET} ${C_YELLOW}%s${C_RESET}\n" "$num_oid"
    fi
    printf "${C_BOLD}VALUE:${C_RESET}       ${C_GREEN}%s${C_RESET}\n" "$val"
  else
    printf "${C_BOLD}NAME:${C_RESET}        ${C_CYAN}%s${C_RESET}\n" "$target"
    printf "${C_BOLD}ERROR:${C_RESET}       ${C_RED}%s${C_RESET}\n" "$raw_out"
  fi

  printf "${C_BOLD}DESCRIPTION:${C_RESET} ${C_GRAY}%s${C_RESET}\n" \
    "${desc:-Description not found in MIB}"
  printf "${C_DIM}────────────────────────────────────────────────────────────${C_RESET}\n"
done
